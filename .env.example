# Local development only. Keep real values in .env.local or the provider dashboards.
# Never commit provider secrets or production values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=

# Stripe stays explicitly in test mode and closed until each gate is enabled.
# Never use live keys or real payment traffic in local verification.
STRIPE_MODE=test
STRIPE_CHECKOUT_ENABLED=false
STRIPE_WEBHOOK_ENABLED=false
STRIPE_LIVE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BOOKING_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Sanity — project ID is public; the dataset is intentionally left blank until
# the owner confirms the real dataset. Never put write/preview/webhook tokens here.
NEXT_PUBLIC_SANITY_PROJECT_ID=ez6qtt5k
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01
SANITY_STUDIO_PROJECT_ID=ez6qtt5k
SANITY_STUDIO_DATASET=
# Hosted Studio URL used by the server-rendered /admin entry point. Keep this
# on the hosted HTTPS URL in production; localhost is for local development only.
SANITY_STUDIO_URL=https://animation-made.sanity.studio
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_PREVIEW_TOKEN=
SANITY_PREVIEW_SECRET=
SANITY_REVALIDATE_SECRET=
SANITY_WRITE_TOKEN=

# Resend is deliberately disabled unless the explicit gate is true. Development
# sends also require the comma-separated test allow-list. Production recipients
# require RESEND_SEND_MODE=production plus both explicit opt-ins; keep that mode
# and the production opt-in false until the owner approves the policy. Mirror
# these variables on the Convex development deployment for durable consumers.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=animationmadecorp@gmail.com
RESEND_TEST_RECIPIENTS=
RESEND_SEND_MODE=development
RESEND_SEND_ENABLED=false
# Production requires this second explicit opt-in in addition to the send gate.
# Keep it false until the owner approves a real production recipient policy.
RESEND_PRODUCTION_SEND_ENABLED=false

# Set this on the Convex development deployment (and mirror it only when a
# local Convex CLI flow explicitly requires it). It is the Clerk Frontend API
# URL, not a secret.
CLERK_JWT_ISSUER_DOMAIN=
